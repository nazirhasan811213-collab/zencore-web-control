v2_trmbull   = input.color (#3BB3E4,       "TRM Buy", group=grp_v2)
v2_trmbear   = input.color (#ffeb3b,       "TRM Sell", group=grp_v2)
v2_trmhold   = input.color (#b2b5be,       "TRM Hold", group=grp_v2)

grp_v2_rsi = "Zencore V2 RSI Colors"
v2_rsi5      = input.color (#17ff00, "RSI 0-5", group=grp_v2_rsi)
v2_rsi10     = input.color (#17ff00, "RSI 5-10", group=grp_v2_rsi)
