//@version=6
indicator('ZenCore AI Dashboard Pro + Alerts — Original + TF2 SOLID HOLD TF2 · PINE 3/4 + CHOP<50 · MTF 3/5/10', dynamic_requests=true, max_bars_back=650, overlay = true, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 200)

// Native calculations below are the ONLY source of chart and webhook values.
zc24_group = "ZenCore TF2 Web Feed"
zc24_feed = input.bool(true, "Aktifkan web feed", group=zc24_group)
zc24_channel = input.string("Unified", "Feed channel", options=["Unified", "Dashboard", "Execution"], group=zc24_group)
zc24_secret = input.string("", "Webhook secret", group=zc24_group, display=display.none)
zc24_symbol_ok = str.contains(syminfo.ticker, "XAUUSD")


// Native SOLID stays latched until SOP CLOSE ALL. Current snapshots must remain fresh.
varip string zc_seq_side = ""
varip int zc_seq_bar = na
varip int zc_seq_trigger = na
varip string zc_seq_seen = ""
varip float zc_seq_source = na
varip int zc_seq_completed = na
varip float zc_seq_entry = na
varip int zc_plan_bar = na
varip int zc_source_bar_index = na
varip float zc_seq_risk = na
varip string zc_seq_plan_mode = ""
varip float zc_seq_tp1 = na
varip float zc_seq_tp2 = na
varip float zc_seq_tp3 = na
varip float draft_sl = na
varip bool zc80_eligible = false
varip int zc80_trigger_passed = na
varip bool zc80_trigger_hema40 = false
varip string[] zc80_seen = array.new_string()
// Keep the latest chart signal separate from the execution plan being managed.
varip string zc_pending_key = ""
varip string zc_pending_side = ""
varip float zc_pending_entry = na
varip int zc_pending_bar = na
varip int zc_pending_at = na
varip bool zc_hold_active = false
varip int zc_hold_closed_at = na
varip string zc_hold_reason = "NO_NATIVE_SOLID"
varip int zc_parent_qualified = na
varip string zc_cycle_kind = "INITIAL"
varip int zc_source_setup_at = na
varip int[] zc_path_times = array.new_int()
varip float[] zc_path_prices = array.new_float()
// A short price path is carried with the event, not sent as extra heartbeats.
if barstate.isrealtime
    if array.size(zc_path_times) == 0 or int(timenow/1000) > int(array.get(zc_path_times,array.size(zc_path_times)-1)/1000)
        array.push(zc_path_times,timenow)
        array.push(zc_path_prices,close)
    else
        array.set(zc_path_times,array.size(zc_path_times)-1,timenow)
        array.set(zc_path_prices,array.size(zc_path_prices)-1,close)
    while array.size(zc_path_times) > 120
        array.shift(zc_path_times)
        array.shift(zc_path_prices)
bool zc_partial_pulse = false
bool zc_partial_buy = false
varip bool xc_half_event_sent = false
varip bool xc_full_event_sent = false
bool zc_close_all_pulse = false
bool zc_seq_pulse = false
int zc_seq_now = barstate.isrealtime ? timenow : time_close
// Capture the actual native label, without changing its trigger or native plan.
var int zc_native_setup = na
int zc_pulse_setup = na
float zc_pulse_entry = na
bool zc_pulse_buy = false
varip bool xc_active = false
varip bool xc_half = false
varip int xc_half_bar = na
varip int xc_stage = 0
varip float xc_entry = na
varip float xc_risk = na
varip float xc_tp1 = na
varip float xc_tp2 = na
varip float xc_tp3 = na
varip float xc_sl = na
varip bool xc_buy = false
varip int xc_setup = na
varip int xc_full_bar = na
varip string xc_exit = "NONE"
varip string xc_reason = ""
string zc_native_reentry = "NONE"


// ==========================================
// 1. User Inputs & UI Settings
// ==========================================
grpMode = "Trading Style Mode"
tradeMode = input.string("Scalping", "Pilih Trading Style", options=["Scalping", "Intraday"], group=grpMode)

grp_vis   = "Visibility Settings"
dashOn    = input.bool(false, 'Dashboard On (Main)', group=grp_vis) 
colorBar  = input.bool(false, "Color Bars via HEMA (Asal)", group=grp_vis)
afibOn    = input.bool(false, "Auto Fibonacci", group=grp_vis)
voidLines = input.bool(false, "Void Lines (StDev)", group=grp_vis)

grp_dash  = "Dashboard Settings"
dashSizeStr = input.string("Small", "Dashboard Size", options=["Tiny", "Small", "Normal"], group=grp_dash)
dashBgColor = input.color(color.new(#0b0e14, 15), 'Dashboard Background', group=grp_dash)
use_dxy_filter = input.bool(false, "Aktifkan Penapis DXY (Tutup utk All Pairs)", group=grp_dash)
dashSize    = dashSizeStr == "Tiny" ? size.tiny : dashSizeStr == "Small" ? size.small : size.normal

grpTM = "Fibo Plan (Kotak Entry)"
TRADE_MODEL_ON = input.bool(true, "Buka Fibo Plan (Kotak Entry)", group=grpTM)
// --- HIDDEN SECURE SETTINGS ---
keepSetups = 1 
extendBars = 20

grpColors = "Warna & Pengurusan Risiko"
tpModeStr = input.string("Fixed R:R", "Mod Sasaran TP", options=["Fibonacci", "Fixed R:R"], group=grpColors)
// --- HIDDEN SECURE SETTINGS ---
rrTP1     = 1.0
rrTP2     = 2.0
rrTP3     = 3.0
colSL     = input.color(color.new(color.red, 0),     "Warna Stoploss", group=grpColors)
colEntry  = input.color(color.new(color.orange, 0),  "Warna Garisan Entry", group=grpColors)
colTP1    = input.color(color.new(color.lime, 0),    "Warna TP1", group=grpColors)
colTP2    = input.color(color.new(color.lime, 0),    "Warna TP2", group=grpColors)
colTP3    = input.color(color.new(color.lime, 0),    "Warna TP3", group=grpColors)
colZoneBg = input.color(color.new(color.yellow, 85), "Warna Dalam Kotak", group=grpColors)
colZoneBd = input.color(color.new(color.yellow, 40), "Warna Border Kotak", group=grpColors)

// ==========================================
// 1.1 ZENCORE V2 CANDLE COLOR SETTINGS
// ==========================================
grp_v2 = "Zencore V2 Candle Colors"
v2_useCol    = input.bool  (true,          "Aktifkan V2 Candle Colors", group=grp_v2)
v2_strat     = input.string("Bj Reversal", "Select a Strategy", options=["Bj Reversal", "MA", "TRM", "RSI Color"], group=grp_v2)
v2_src       = input.source(close,         "MA source", group=grp_v2)

v2_tsistrat  = input.string("Fast",        "TRM Speed Control", options=["Fast", "Slow"], group=grp_v2)
v2_rsistrat  = input.string("Slow",        "RSI Bar Color Speed Control", options=["Slow", "Fast"], group=grp_v2)

// --- HIDDEN SECURE SETTINGS ---
v2_alphaInput= 0.5 
v2_aLength   = 5
v2_Length    = 8
v2_hemaslow  = 5
v2_hemaslow2 = 9
v2_hemaslow3 = 21

v2_bullcol   = input.color (#64b5f6,       "Bull Trend Color", group=grp_v2)
v2_bearcol   = input.color (#ef5350,       "Bear Trend Color", group=grp_v2)
