v2_bearrev   = input.color (#fff176,       "Bearish Reversal Color", group=grp_v2)

v2_hemabull  = input.color (#64b5f6,       "MA Bull Color", group=grp_v2)
v2_hemabear  = input.color (#e91e63,       "MA Bear Color", group=grp_v2)
