//@version=6
indicator("ZenCore TF15 Real-Time Entry Candidate", shorttitle="ZC RT 15M", overlay=false, dynamic_requests=true, max_bars_back=650)

// One permanent alert feeds all supported markets to ZenCore Web Control.
// CANDIDATE: intrabar SOLID can disappear before close. Not Pine-compiled or live-tested.
// Run this bridge on a 15-minute chart. It does not draw or alter the original indicator.
grp="ZenCore Multi-Pair Web Feed"
feedEnabled=input.bool(true,"Enable 3-Pair Batch Feed",group=grp)
showStatus=input.bool(true,"Show Feed Status",group=grp)
tpModeStr=input.string("Fixed R:R","Mod Sasaran TP",options=["Fibonacci","Fixed R:R"],group=grp)
goldAtrMultiplier=input.float(1.0,"Gold 15M ATR multiplier — SOP 1 Oct",minval=0.10,maxval=2.0,step=0.05,group=grp)

f_hema(float src,int len)=>
    int half=int(math.max(1,math.round(len/2)))
    int root=int(math.max(1,math.round(math.sqrt(len))))
    ta.ema(2*ta.ema(src,half)-ta.ema(src,len),root)

f_gd(float src,int len,float alpha)=>
    ta.ema(src,len)*(1+alpha)-ta.ema(ta.ema(src,len),len)*alpha

f_t3(float src,int len,float alpha)=>
    f_gd(f_gd(f_gd(src,len,alpha),len,alpha),len,alpha)

f_ema_step(float previous,float value,int len)=>
    float k=2.0/(len+1.0)
    na(previous)?value:value*k+previous*(1-k)

f_num(float value)=>
    na(value)?"null":str.tostring(value,format.mintick)

f_bool(bool value)=>
    value?"true":"false"

f_int(int value)=>
    na(value)?"null":str.tostring(value)

f_quote(string value)=>
    string safe=str.replace_all(value,"\\","\\\\")
    safe:=str.replace_all(safe,"\"","\\\"")
    "\"" + safe + "\""

f_hema_live()=>
    float fast=f_hema(close,20)
    float slow=f_hema(close,40)
    [fast,slow,fast[1],slow[1]]

f_hema23_num(float value)=>
    na(value)?"null":str.tostring(value,"#.########")

f_hema23_json(float f2,float s2,float pf2,float ps2,float f3,float s3,float pf3,float ps3)=>
    "{\"version\":\"HEMA1530_V1\",\"tf15\":{\"fast\":"+f_hema23_num(f2)+",\"slow\":"+f_hema23_num(s2)+",\"previousFast\":"+f_hema23_num(pf2)+",\"previousSlow\":"+f_hema23_num(ps2)+"},\"tf30\":{\"confirmed\":false,\"fast\":"+f_hema23_num(f3)+",\"slow\":"+f_hema23_num(s3)+",\"previousFast\":"+f_hema23_num(pf3)+",\"previousSlow\":"+f_hema23_num(ps3)+"}}"

// Executes independently inside each requested 15-minute symbol context.
// Forecast EMA states are updated only when their candles close,
// while HEMA entry confirmations below use the current live ribbon modes.
f_scan3()=>
    float e9=ta.ema(close,9)
    float e20=ta.ema(close,20)
    float e50=ta.ema(close,50)
    float a14=ta.atr(14)
    // Keep ATR itself unchanged for analysis. Only the gold trade plan is narrowed.
    float planRange=a14*(str.contains(syminfo.ticker,"XAUUSD")?goldAtrMultiplier:1.0)
    float r14=ta.rsi(close,14)
    float b20=ta.sma(close,20)
    float h20=f_hema(close,20)
    float h40=f_hema(close,40)

    float volNow=nz(volume,0)
    float volAvg=nz(ta.sma(volNow,20),1)
    bool hasVol=volAvg>1
    float rv=hasVol?volNow/volAvg:0

    float esa=ta.ema(hlc3,10)
    float dev=ta.ema(math.abs(hlc3-esa),10)
    float ci=dev==0?0:(hlc3-esa)/(0.015*dev)
    float w1=ta.ema(ci,15)
    float w2=ta.sma(w1,4)
    bool wtBuy=ta.crossover(w1,w2)
    bool wtSell=ta.crossunder(w1,w2)

    float trSum=math.sum(ta.tr,14)
    float hh=ta.highest(high,14)
    float ll=ta.lowest(low,14)
    float ch=hh==ll?100:100*(math.log10(trSum/(hh-ll))/math.log10(14))
    bool choppy=ch>61.8

    var float c15=na
    var float c30=na
    var float c60=na
    var float em15=na
    var float em30=na
    var float em60=na
    if time_close==time_close("15")
        c15:=close
        em15:=f_ema_step(em15,close,20)
    if time_close==time_close("30")
        c30:=close
        em30:=f_ema_step(em30,close,20)
    if time_close==time_close("60")
        c60:=close
        em60:=f_ema_step(em60,close,20)

    int mtf15=na(c15) or na(em15)?0:c15>em15?1:-1
    int mtf30=na(c30) or na(em30)?0:c30>em30?1:-1
    int mtf60=na(c60) or na(em60)?0:c60>em60?1:-1
    int localTrend=close>e20?1:-1
    int globalTrend=localTrend+mtf15+mtf30+mtf60

    int stars=0
    stars:=(globalTrend>=2 or globalTrend<=-2)?stars+1:stars
    stars:=(hasVol and volNow>volAvg)?stars+1:stars
    stars:=((globalTrend>0 and r14<65) or (globalTrend<0 and r14>35))?stars+1:stars
    stars:=((globalTrend>0 and w1>w2) or (globalTrend<0 and w1<w2))?stars+1:stars
    stars:=((globalTrend>0 and close>e9) or (globalTrend<0 and close<e9))?stars+1:stars
    float probability=20+stars*13

    [bbMid,bbUp,bbLo]=ta.bb(close,20,2)
    bool alignedBull=close>e9 and e9>e20 and e20>e50
    bool alignedBear=close<e9 and e9<e20 and e20<e50
    float trendScore=alignedBull or alignedBear?30:((close>e20 and e20>e50) or (close<e20 and e20<e50)?15:5)
    float gap=math.abs(w1-w2)
    float maxGap=ta.highest(gap,20)
    float momScore=maxGap>0?(gap/maxGap)*30:15
    float width=bbUp-bbLo
    float widthAvg=ta.sma(width,20)
    float volScore=width>widthAvg?20:width>widthAvg*0.8?10:5
    float driverScore=hasVol?math.min((rv/1.5)*20,20):10
    float power=math.round(trendScore+momScore+volScore+driverScore)
    string forecast=globalTrend>0 and w1>w2 and not choppy?"BULLISH":globalTrend<0 and w1<w2 and not choppy?"BEARISH":choppy?"CHOPPY":"NEUTRAL"

    float t3a=f_t3(close,5,0.5)
    float t3b=f_t3(close,8,0.5)
    bool v2uc=t3a>=t3b and close>t3b
    bool v2dc=t3a<=t3b and close<t3b
    bool v2dr=t3a>=t3b and close<t3b
    bool v2ur=t3a<=t3b and close>t3b

    bool zoneBuy=ta.crossover(close,b20)
    bool zoneSell=ta.crossunder(close,b20)
    var string lastSide="WAIT"
    var bool isBuy=false
    var float entry=na
    var float initialSl=na
    var float activeSl=na
    var float tp1=na
    var float tp2=na
    var float tp3=na
    var bool active=false
    var bool triggered=false
    var int setupAt=na
    var bool hit1=false
    var bool hit2=false
    var bool hit3=false
    var bool slHit=false
    var int lockStage=0
    var int lockBar=na
    var bool halfArmed=false
    var int halfBar=na
    var bool completed=false
    var int fullBar=na
    var string closeType="NONE"
    var string closeReason=""
    string slMove="NONE"
    bool oppositeYellow=false

    if zoneBuy or zoneSell
        setupAt:=time
        isBuy:=zoneBuy
        lastSide:=zoneBuy?"BUY":"SELL"
        entry:=zoneBuy?close+2*syminfo.mintick:close-2*syminfo.mintick
        initialSl:=zoneBuy?entry-planRange:entry+planRange
        activeSl:=initialSl
        tp1:=tpModeStr=="Fibonacci"?initialSl+(entry-initialSl)*1.618:zoneBuy?entry+planRange:entry-planRange
        tp2:=tpModeStr=="Fibonacci"?initialSl+(entry-initialSl)*2.618:zoneBuy?entry+2*planRange:entry-2*planRange
        tp3:=tpModeStr=="Fibonacci"?initialSl+(entry-initialSl)*4.236:zoneBuy?entry+3*planRange:entry-3*planRange
        active:=true
        triggered:=false
        hit1:=false
        hit2:=false
        hit3:=false
        slHit:=false
        lockStage:=0
        lockBar:=na
        halfArmed:=false
        halfBar:=na
        completed:=false
        fullBar:=na
        closeType:="NONE"
        closeReason:=""

    if active and not triggered
        triggered:=isBuy?close>entry:close<entry

    if active and triggered
        bool stopNow=isBuy?low<=activeSl:high>=activeSl
        if stopNow
            active:=false
            slHit:=true
            halfArmed:=false
            completed:=true
            fullBar:=bar_index
            closeType:=lockStage==3?"SL_TP2_LOCK":lockStage==2?"SL_TP1_LOCK":lockStage==1?"SL_BREAKEVEN":"SL_INITIAL"
            closeReason:=lockStage==3?"Protected SL at TP2 hit":lockStage==2?"Protected SL at TP1 hit":lockStage==1?"Breakeven SL hit":"Initial SL hit"
        else
            bool tp1Now=isBuy?high>=tp1:low<=tp1
            bool tp2Now=isBuy?high>=tp2:low<=tp2
            bool tp3Now=isBuy?high>=tp3:low<=tp3
            if tp1Now and not hit1
                hit1:=true
                activeSl:=entry
                lockStage:=1
                lockBar:=bar_index
                slMove:="MOVE_SL_ENTRY"
            if tp2Now and not hit2
                hit2:=true
                activeSl:=tp1
                lockStage:=2
                lockBar:=bar_index
                slMove:="MOVE_SL_TP1"
            if tp3Now and not hit3
                hit3:=true
                activeSl:=tp2
                lockStage:=3
                lockBar:=bar_index
                slMove:="MOVE_SL_TP2"

    if active and triggered
        bool inProfit=isBuy?close>entry:close<entry
        bool emergency=isBuy?close<b20:close>b20
        bool halfSignal=inProfit and (isBuy?(wtSell or r14>=75):(wtBuy or r14<=25))
        if emergency
            active:=false
            slHit:=true
            halfArmed:=false
            completed:=true
            fullBar:=bar_index
            closeType:="EMERGENCY"
            closeReason:="Emergency close all"
        else if halfSignal and not halfArmed
            halfArmed:=true
            halfBar:=bar_index
            closeReason:="Close Separuh signal"

    if active and halfArmed and barstate.isconfirmed and bar_index>halfBar
        oppositeYellow:=isBuy?v2dr:v2ur
        if oppositeYellow
            active:=false
            halfArmed:=false
            completed:=true
            fullBar:=bar_index
            closeType:="OPPOSITE_YELLOW"
            closeReason:="Confirmed opposite yellow candle"

    // Re-entry is an event on this confirmed 15M bar, never a carried position label.
    var int lastReentryBar=0
    bool crossE9Up=ta.crossover(close,e9)
    bool crossE9Down=ta.crossunder(close,e9)
    bool crossEntryUp=ta.crossover(close,entry)
    bool crossEntryDown=ta.crossunder(close,entry)
    bool reBuy=(slHit and isBuy and (crossEntryUp or (close>entry and wtBuy)) and close>e9) or (active and isBuy and crossE9Up and w1>w2 and close>e20 and close>entry) or (h20>h40 and not active and crossE9Up and w1>w2)
    bool reSell=(slHit and not isBuy and (crossEntryDown or (close<entry and wtSell)) and close<e9) or (active and not isBuy and crossE9Down and w1<w2 and close<e20 and close<entry) or (h20<h40 and not active and crossE9Down and w1<w2)
    bool reBuyOnly=reBuy and not reSell
    bool reSellOnly=reSell and not reBuy
    bool reHema=(reBuyOnly and math.min(open,close)>math.max(h20,h40)) or (reSellOnly and math.max(open,close)<math.min(h20,h40))
    int mtfTotal=mtf15+mtf30+mtf60
    bool reHigh=(reBuyOnly and mtfTotal>=2 and stars>=3 and rv>1) or (reSellOnly and mtfTotal<=-2 and stars>=3 and rv>1)
    bool reWeak=(reBuyOnly and mtfTotal<=0) or (reSellOnly and mtfTotal>=0) or stars<=2
    bool reTriggered=(reBuyOnly or reSellOnly) and reHema and not reWeak and bar_index-lastReentryBar>5
    string reType=reTriggered?(reHigh?"HIGH":"NORMAL"):"NONE"
    string reSide=reTriggered?(reBuyOnly?"BUY":"SELL"):"WAIT"
    if reTriggered
        lastReentryBar:=bar_index
        active:=true
        isBuy:=reBuyOnly
        lastSide:=reSide
        entry:=close
        initialSl:=reBuyOnly?entry-planRange:entry+planRange
        activeSl:=initialSl
        tp1:=tpModeStr=="Fibonacci"?initialSl+(entry-initialSl)*1.618:reBuyOnly?entry+planRange:entry-planRange
        tp2:=tpModeStr=="Fibonacci"?initialSl+(entry-initialSl)*2.618:reBuyOnly?entry+2*planRange:entry-2*planRange
        tp3:=tpModeStr=="Fibonacci"?initialSl+(entry-initialSl)*4.236:reBuyOnly?entry+3*planRange:entry-3*planRange
        triggered:=true
        hit1:=false
        hit2:=false
        hit3:=false
        slHit:=false
        halfArmed:=false
        completed:=false
        lockStage:=0
        closeType:="NONE"
        closeReason:=""

    string side=active?(isBuy?"BUY":"SELL"):lastSide
    bool priceCross=side=="BUY"?crossEntryUp:side=="SELL"?crossEntryDown:false
    bool pricePast=not na(entry) and (side=="BUY"?close>entry:side=="SELL"?close<entry:false)
    bool sopBuy=active?isBuy:h20>h40
    bool sop1=sopBuy?w1>w2:w1<w2
    bool sop2=sopBuy?close>b20:close<b20
    bool sop3=sopBuy?h20>h40:h20<h40
    bool sop4=sopBuy?v2uc:v2dc
    bool solid=active and triggered and not reTriggered and (isBuy?(close>entry and close>b20 and w1>w2 and not wtSell and r14<75):(close<entry and close<b20 and w1<w2 and not wtBuy and r14>25))

    bool closedNow=completed and bar_index==fullBar
    string exitStage=completed?"CLOSED":halfArmed?"WAIT_YELLOW":active?"HOLD":"IDLE"
    string exitAction=closedNow?(closeType=="EMERGENCY"?"EXIT_ALL":closeType=="OPPOSITE_YELLOW"?"EXIT_REMAINING":"EXIT_SL"):halfArmed and bar_index==halfBar?"CLOSE_50_NOW":halfArmed?"WAIT_OPPOSITE_YELLOW":active?"HOLD":"IDLE"
    int remaining=completed?0:halfArmed?50:active?100:0
    string yellowType=oppositeYellow?(isBuy?"BEARISH_YELLOW":"BULLISH_YELLOW"):"NONE"
    string slLabel=completed?"CLOSED":not active?"IDLE":lockStage==3?"TP2_LOCKED":lockStage==2?"TP1_LOCKED":lockStage==1?"BREAKEVEN":"INITIAL"
    string webAction=zoneBuy?"BUY":zoneSell?"SELL":globalTrend>0?"LONG_BIAS":globalTrend<0?"SHORT_BIAS":"WAIT"

    [time,bar_index,open,high,low,close,e9,e20,e50,h20,h40,b20,w1,w2,r14,ch,rv,globalTrend,probability,stars,a14,entry,initialSl,activeSl,tp1,tp2,tp3,active,isBuy,hit1,hit2,hit3,slHit,side,solid,pricePast,sop1,sop2,sop3,sop4,forecast,power,exitStage,exitAction,halfArmed,oppositeYellow,remaining,yellowType,closeType,closeReason,lockStage,slLabel,slMove,slMove!="NONE",webAction,priceCross,reType,reSide,reTriggered and reHema,h20[1],h40[1],setupAt,a14[1]]

var string[] symbols=array.from("OANDA:XAUUSD","OANDA:GBPUSD","OANDA:GBPJPY")
var string[] aliases=array.from("XAUUSD","GBPUSD","GBPJPY")

bool correctTf=timeframe.period=="15"
string marketsJson=""
varip string[] emittedSetupKeys=array.new_string(3,"")
varip string[] armedSetupKeys=array.new_string(3,"")
varip bool[] solidArmed=array.new_bool(3,false)
varip int[] impulseBars=array.new_int(3,0)
varip float[] impulseOpens=array.new_float(3,na)
varip float[] impulseExtremes=array.new_float(3,na)
varip float[] impulseAtrs=array.new_float(3,na)
varip bool[] lastEligible=array.new_bool(3,false)
varip int lastFeedSentAt=0
varip string lastSentGateState=""
varip int[] recentFeedSends=array.new_int()
string gateState=""
bool emitEntry=false
bool emitSetup=false

if feedEnabled and correctTf
    for i=0 to array.size(symbols)-1
        string ticker=array.get(symbols,i)
        string alias=array.get(aliases,i)
        [bt,bi,o,h,l,c,e9,e20,e50,h20,h40,b20,w1,w2,r14,ch,rv,gt,prob,stars,a14,entry,initialSl,activeSl,tp1,tp2,tp3,active,isBuy,hit1,hit2,hit3,slHit,side,solid,pricePast,sop1,sop2,sop3,sop4,forecast,power,exitStage,exitAction,halfArmed,oppositeYellow,remaining,yellowType,closeType,closeReason,lockStage,slLabel,slMove,slMoved,webAction,priceCross,reType,reSide,reHema,previousH20,previousH40,setupAt,previousAtr]=request.security(ticker,"15",f_scan3(),gaps=barmerge.gaps_off,lookahead=barmerge.lookahead_off,ignore_invalid_symbol=true,calc_bars_count=650)
        [m5close,m5h20,m5h40]=request.security(ticker,"5",[close,f_hema(close,20),f_hema(close,40)],gaps=barmerge.gaps_off,lookahead=barmerge.lookahead_off,ignore_invalid_symbol=true,calc_bars_count=180)
        [f3,s3,pf3,ps3]=request.security(ticker,"30",f_hema_live(),gaps=barmerge.gaps_off,lookahead=barmerge.lookahead_off,ignore_invalid_symbol=true,calc_bars_count=180)
        string hemaJson=f_hema23_json(h20,h40,previousH20,previousH40,f3,s3,pf3,ps3)
        string m5pos=na(m5close)?"WAIT":m5close>math.max(m5h20,m5h40)?"ABOVE":m5close<math.min(m5h20,m5h40)?"BELOW":"INSIDE"
        bool sop5=side=="BUY"?m5h20>m5h40:side=="SELL"?m5h20<m5h40:false

        int greens=(sop1?1:0)+(sop2?1:0)+(sop3?1:0)+(sop4?1:0)+(sop5?1:0)
        bool buy=side=="BUY"
        bool direction=buy or side=="SELL"
        bool forecastOk=buy?((forecast=="NEUTRAL" and power>50) or (forecast=="BULLISH" and power>50)):((forecast=="NEUTRAL" and power<50) or (forecast=="BEARISH" and power>50))
        bool ownHema=buy?h20>h40:h20<h40
        bool higherHema=buy?f3>s3:f3<s3
        // SOLID is held across candles; confirmations and pullback use current values.
        string setupKey=alias+"|"+side+"|"+str.tostring(setupAt)
        if array.get(armedSetupKeys,i)!=setupKey
            array.set(armedSetupKeys,i,setupKey)
            array.set(solidArmed,i,false)
            array.set(impulseBars,i,0)
            array.set(impulseOpens,i,na)
            array.set(impulseExtremes,i,na)
            array.set(impulseAtrs,i,na)
        bool previouslyArmed=array.get(solidArmed,i)
        bool setupEnded=not active or slHit or exitStage=="CLOSED" or (buy?c<=initialSl:c>=initialSl)
        if setupEnded
            array.set(solidArmed,i,false)
            array.set(impulseBars,i,0)
        else if solid
            array.set(solidArmed,i,true)
        bool solidLatched=array.get(solidArmed,i)
        if solidLatched!=previouslyArmed
            emitSetup:=true
        float extreme=buy?h:l
        float leg=buy?extreme-o:o-extreme
        bool largeCandle=solidLatched and not na(previousAtr) and previousAtr>0 and leg>=1.5*previousAtr
        int impulseBar=array.get(impulseBars,i)
        if largeCandle and bt>=impulseBar
            if bt!=impulseBar
                array.set(impulseBars,i,bt)
                array.set(impulseOpens,i,o)
                array.set(impulseExtremes,i,extreme)
                array.set(impulseAtrs,i,previousAtr)
            else
                float oldExtreme=array.get(impulseExtremes,i)
                array.set(impulseExtremes,i,buy?math.max(oldExtreme,extreme):math.min(oldExtreme,extreme))
        impulseBar:=array.get(impulseBars,i)
        float impulseOpen=array.get(impulseOpens,i)
        float impulseExtreme=array.get(impulseExtremes,i)
        float impulseAtr=array.get(impulseAtrs,i)
        bool impulseRequired=impulseBar>0
        float impulseDistance=buy?impulseExtreme-impulseOpen:impulseOpen-impulseExtreme
        float pullbackLevel=impulseRequired?impulseExtreme+(buy?-1:1)*0.4*impulseDistance:na
        bool pullbackReady=not na(previousAtr) and previousAtr>0 and (not impulseRequired or (buy?c<=pullbackLevel:c>=pullbackLevel))
        bool entryRange=buy?(c>entry and c<tp1):(c<entry and c>tp1)
        bool eligible=direction and solidLatched and pullbackReady and pricePast and greens>=4 and forecastOk and ownHema and higherHema and entryRange and not na(setupAt)
        if eligible!=array.get(lastEligible,i)
            emitSetup:=true
            array.set(lastEligible,i,eligible)
        // Track confirmations even while eligibility remains false.
        gateState+=alias+"|"+side+"|"+str.tostring(greens)+"|"+forecast+"|"+f_bool(forecastOk)+"|"+f_bool(ownHema)+"|"+f_bool(higherHema)+"|"+f_bool(pricePast)+"|"+f_bool(pullbackReady)+"|"+f_bool(active)+";"
        bool entryEvent=barstate.isrealtime and eligible and array.get(emittedSetupKeys,i)!=setupKey
        if entryEvent
            array.set(emittedSetupKeys,i,setupKey)
            emitEntry:=true
        // This event is latched intrabar; a later false SOLID cannot emit it twice.
        string entryMeta="{\"version\":\"TF15_ENTRY_EVENT_V1\",\"policy\":\"SEQUENTIAL_ATR40_V1\",\"solidLatched\":"+f_bool(solidLatched)+",\"atrBeforeBar\":"+f_num(previousAtr)+",\"impulseRequired\":"+f_bool(impulseRequired)+",\"impulseBar\":"+f_int(impulseBar)+",\"impulseOpen\":"+f_num(impulseOpen)+",\"impulseExtreme\":"+f_num(impulseExtreme)+",\"impulseAtr\":"+f_num(impulseAtr)+",\"entryEvent\":"+f_bool(entryEvent)+",\"setupAt\":"+f_int(setupAt)+"}"
        string row="["
        row+=f_quote(alias)+","+f_int(bt)+","+f_int(bi)+","
        row+=f_num(o)+","+f_num(h)+","+f_num(l)+","+f_num(c)+","
        row+=f_num(e9)+","+f_num(e20)+","+f_num(e50)+","+f_num(h20)+","+f_num(h40)+","+f_num(b20)+","
        row+=f_num(w1)+","+f_num(w2)+","+f_num(r14)+","+f_num(ch)+","+f_num(rv)+","+f_int(gt)+","+f_num(prob)+","+f_int(stars)+","+f_num(a14)+","
        row+=f_num(entry)+","+f_num(initialSl)+","+f_num(activeSl)+","+f_num(tp1)+","+f_num(tp2)+","+f_num(tp3)+","
        row+=f_bool(active)+","+f_bool(isBuy)+","+f_bool(hit1)+","+f_bool(hit2)+","+f_bool(hit3)+","+f_bool(slHit)+","
        row+=f_quote(side)+","+f_bool(solid)+","+f_bool(pricePast)+","+f_bool(sop1)+","+f_bool(sop2)+","+f_bool(sop3)+","+f_bool(sop4)+","+f_bool(sop5)+","
        row+=f_quote(forecast)+","+f_num(power)+","+f_quote(m5pos)+","+f_num(m5close)+","+f_num(m5h20)+","+f_num(m5h40)+","
        row+=f_quote(exitStage)+","+f_quote(exitAction)+","+f_bool(halfArmed)+","+f_bool(oppositeYellow)+","+f_int(remaining)+","+f_quote(yellowType)+","+f_quote(closeType)+","+f_quote(closeReason)+","
        row+=f_int(lockStage)+","+f_quote(slLabel)+","+f_quote(slMove)+","+f_bool(slMoved)+","+f_quote(webAction)+","+f_bool(priceCross)+","+f_quote(reType)+","+f_quote(reSide)+","+f_bool(reHema)+","+hemaJson+","+entryMeta+"]"
        marketsJson+=(i>0?",":"")+row

    string payload="{\"schemaVersion\":\"32.3-EXIT-STEPLOCK\",\"source\":\"ZenCore Multi-Pair Feed\",\"encoding\":\"zencore-compact-v1\",\"timeframe\":\"15\",\"goldAtrMultiplier\":"+str.tostring(goldAtrMultiplier)+",\"tpMode\":\""+tpModeStr+"\",\"markets\":["+marketsJson+"]}"
    payload:=str.replace(payload,"{", "{\"feedUpdateVersion\":\"GATE_CHANGE_HEARTBEAT_V1\",\"snapshotIntervalMs\":20000,\"feedVersion\":\"TF15_REALTIME_V1\",\"confirmed\":"+f_bool(barstate.isconfirmed)+",\"emittedAt\":"+str.tostring(timenow)+",")
    // Update dashboard on gate changes and on a 20s heartbeat, not only close.
    // TradingView stops regular alerts above 15 triggers/3min. Cap at 14 and
    // reserve four slots beyond the ten routine updates for priority events.
    if barstate.isrealtime
        while array.size(recentFeedSends)>0 and timenow-array.get(recentFeedSends,0)>=180000
            array.shift(recentFeedSends)
        bool priorityUpdate=emitEntry or emitSetup or barstate.isconfirmed or gateState!=lastSentGateState
        bool heartbeatDue=timenow-lastFeedSentAt>=20000
        int sentCount=array.size(recentFeedSends)
        bool sendAllowed=sentCount<14 and (priorityUpdate or (heartbeatDue and sentCount<10))
        if sendAllowed
            alert(payload,alert.freq_all)
            array.push(recentFeedSends,timenow)
            lastFeedSentAt:=timenow
            lastSentGateState:=gateState

var table status=na
if showStatus
    if barstate.isfirst
        status:=table.new(position.top_right,2,4,bgcolor=color.new(#07131d,5),border_width=1)
    if barstate.islast
        table.cell(status,0,0,"ZENCORE MULTI-PAIR",text_color=color.aqua)
        table.cell(status,1,0,"TF15 • SOLID HOLD • ATR40",text_color=color.lime)
        table.cell(status,0,1,"Markets",text_color=color.gray)
        table.cell(status,1,1,"3",text_color=color.white)
        table.cell(status,0,2,"Chart TF",text_color=color.gray)
        table.cell(status,1,2,correctTf?"15M READY":"SET CHART TO 15M",text_color=correctTf?color.lime:color.red)
        table.cell(status,0,3,"Alert",text_color=color.gray)
        table.cell(status,1,3,feedEnabled?"BATCH ACTIVE":"OFF",text_color=feedEnabled?color.lime:color.orange)

plot(na,title="Feed only")
